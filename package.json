{
  "name": "nhlstats-v2-frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev:nuxt dev:convex --ui=tui",
    "dev:nuxt": "nuxt dev --dotenv .env.local --host localhost --port 3000 --strictPort",
    "dev:convex": "convex dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "test": "vp test",
    "test:browser": "playwright test",
    "test:browser:update": "playwright test --update-snapshots",
    "check": "vp run verify",
    "check:quiet": "vp run --log=grouped verify",
    "lint": "vp lint",
    "typecheck": "nuxt typecheck --dotenv .env.local --checker golar",
    "test:ui": "vp test --ui",
    "format": "vp fmt",
    "format:check": "vp fmt --check"
  },
  "dependencies": {
    "@better-auth/core": "1.7.14",
    "@better-auth/oauth-provider": "1.7.14",
    "@lupinum/better-convex-nuxt": "1.0.0-rc.6",
    "@nuxt/hints": "^1.1.5",
    "@nuxtjs/mcp-toolkit": "^0.24.3",
    "@nuxtjs/seo": "6.0.1",
    "agents": "^0.31.0",
    "better-auth": "1.7.14",
    "convex": "^1.48.0",
    "nuxt": "^4.6.3",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@golar/vue": "^0.1.11",
    "@iconify-json/mdi": "^1.2.3",
    "@nuxt/test-utils": "^4.3.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@~7.0.2",
    "@unocss/nuxt": "^66.12.0",
    "@unocss/preset-icons": "^66.12.0",
    "@unocss/reset": "^66.12.0",
    "@vitest/ui": "catalog:",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/nuxt": "^15.0.0",
    "convex-test": "^0.0.66",
    "golar": "^0.1.11",
    "happy-dom": "^21.0.4",
    "turbo": "^2.11.10",
    "unocss": "^66.12.0",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0"
}
