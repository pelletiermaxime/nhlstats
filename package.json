{
  "name": "nhlstats-v2-frontend",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev:nuxt dev:convex --ui=tui",
    "dev:nuxt": "portless nhlstats nuxt dev --dotenv .env.local",
    "dev:convex": "convex dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:browser:update": "playwright test --update-snapshots",
    "check": "turbo run lint typecheck test test:browser",
    "check:quiet": "turbo run lint typecheck test test:browser --output-logs=errors-only",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@nuxt/eslint-config": "^1.15.2",
    "@nuxt/test-utils": "^4.0.2",
    "@playwright/test": "^1.59.1",
    "@unocss/nuxt": "^66.6.8",
    "@unocss/preset-icons": "^66.6.8",
    "@unocss/reset": "^66.6.8",
    "@vitest/ui": "4.1.5",
    "@vue/test-utils": "^2.4.8",
    "@vueuse/nuxt": "^14.2.1",
    "eslint": "^10.2.1",
    "happy-dom": "^20.9.0",
    "portless": "^0.10.3",
    "turbo": "^2.9.6",
    "typescript": "^6.0.3",
    "unocss": "^66.6.8",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.7",
    "zod": "^4.3.6"
  },
  "dependencies": {
    "@convex-dev/better-auth": "^0.12.0",
    "@nuxt/hints": "^1.0.3",
    "@nuxtjs/mcp-toolkit": "^0.14.0",
    "@nuxtjs/seo": "5.1.3",
    "agents": "^0.11.5",
    "better-auth": "^1.6.9",
    "better-convex-nuxt": "^0.3.4",
    "convex": "^1.36.1",
    "nuxt": "^4.4.2",
    "vue": "^3.5.33"
  },
  "pnpm": {
    "overrides": {
      "h3": "1.15.10"
    }
  }
}
