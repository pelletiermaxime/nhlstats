{
	"name": "nhlstats-desktop",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "NHL Stats desktop app with Electrobun",
	"scripts": {
		"start": "electrobun run",
		"dev": "electrobun dev",
		"dev:watch": "electrobun dev --watch",
		"build:dev": "bun install && electrobun build",
		"build:canary": "electrobun build --env=canary",
		"build:stable": "electrobun build --env=stable"
	},
	"dependencies": {
		"electrobun": "^1.15.1"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"concurrently": "^9.1.0"
	}
}
